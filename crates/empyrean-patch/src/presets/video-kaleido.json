  "edges": [
    { "from": { "node": "v", "port": "tex" }, "to": { "node": "ts", "port": "tex" } },
    { "from": { "node": "effects", "port": "effects" }, "to": { "node": "effects_render", "port": "effects" } },
    { "from": { "node": "strokes", "port": "points" }, "to": { "node": "strokes_render", "port": "points" } },
    { "from": { "node": "ts", "port": "out" }, "to": { "node": "overlay", "port": "base" } },
    { "from": { "node": "effects_render", "port": "out" }, "to": { "node": "overlay", "port": "over" } },
    { "from": { "node": "overlay", "port": "out" }, "to": { "node": "overlay2", "port": "base" } },
    { "from": { "node": "strokes_render", "port": "out" }, "to": { "node": "overlay2", "port": "over" } },
    { "from": { "node": "overlay2", "port": "out" }, "to": { "node": "out", "port": "in" } }
  ],
  "exposed": [
    { "node": "ts", "param": "kaleido", "label": "Kaleidoscope" },
    { "node": "ts", "param": "zoom", "label": "Zoom" }
  ]
