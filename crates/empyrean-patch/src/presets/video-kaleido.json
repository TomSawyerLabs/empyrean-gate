{
  "format": 5,
  "id": "builtin-video-kaleido",
  "name": "Video Kaleido",
  "description": "The live video feed (Video tab) folded through a six-way kaleidoscope. Dark until a video source is running.",
  "nodes": [
    { "id": "v", "kind": "video_in", "name": "", "params": {}, "pos": [40, 100] },
    { "id": "ts", "kind": "texture_sample", "name": "", "params": { "kaleido": 6, "saturation": 1.2, "zoom": 1.2 }, "pos": [300, 100] },
    { "id": "out", "kind": "output", "name": "", "params": {}, "pos": [560, 100] },
    { "id": "effects", "kind": "effects_in", "name": "", "params": {}, "pos": [300, 320] },
    { "id": "effects_render", "kind": "render_effects", "name": "", "params": {}, "pos": [40, 320] },
    { "id": "strokes", "kind": "touch_dabs", "name": "", "params": {}, "pos": [-220, 540] },
    { "id": "strokes_render", "kind": "render_points", "name": "", "params": {}, "pos": [-480, 540] },
    { "id": "overlay", "kind": "blend", "name": "", "params": { "mode": 0, "opacity": 1 }, "pos": [430, 220] },
    { "id": "overlay2", "kind": "blend", "name": "", "params": { "mode": 0, "opacity": 1 }, "pos": [430, 220] }
