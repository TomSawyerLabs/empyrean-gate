    {
      "id": "flow",
      "kind": "code",
      "name": "subtle physical stereo trail",
      "params": { "brightness": 0.62, "left_hue": 0.57, "right_hue": 0.91, "saturation": 0.74, "sensitivity": 2.7, "side_fill": 0.08, "speed": 0.14 },
      "pos": [1535, 1551],
      "code": {
        "inputs": [
          { "name": "left", "shape": "scalar", "min": 0, "max": 1, "default": 0 },
          { "name": "right", "shape": "scalar", "min": 0, "max": 1, "default": 0 },
          { "name": "pan", "shape": "scalar", "min": -1, "max": 1, "default": 0 },
          { "name": "sweep", "shape": "scalar", "min": -1, "max": 1, "default": 0 },
          { "name": "activity", "shape": "scalar", "min": 0, "max": 1, "default": 0 },
          { "name": "sensitivity", "shape": "scalar", "min": 0, "max": 6, "default": 2.7 },
          { "name": "side_fill", "shape": "scalar", "min": 0, "max": 0.5, "default": 0.08 },
          { "name": "speed", "shape": "scalar", "min": 0, "max": 1, "default": 0.14, "integrate": true },
          { "name": "left_hue", "shape": "scalar", "min": 0, "max": 1, "default": 0.57 },
          { "name": "right_hue", "shape": "scalar", "min": 0, "max": 1, "default": 0.91 },
          { "name": "saturation", "shape": "scalar", "min": 0, "max": 1, "default": 0.74 },
          { "name": "brightness", "shape": "scalar", "min": 0, "max": 2, "default": 0.62 }
        ],
        "outputs": [{ "name": "out", "shape": "field_color", "min": 0, "max": 1, "default": 0 }],
        "body": "// A trail across the ring, left to right as the gate is drawn (spoke 0 at\n// the bottom, so c.pos.y runs from -1 on the left to +1 on the right, the\n// axis Transform's mirror flips). `pan` (right minus left) puts the head\n// where the mix sits; `sweep` (fast pan minus slow pan) says which way it\n// is moving and draws a tail out behind the head. The sweep and `activity`\n// (mixer motion) light it, and each side glows faintly with its own\n// channel's level and hue (`side_fill`).\nlet x = c.pos.y;\nlet head = clamp(pan * sensitivity, -1.0, 1.0);\nlet push = clamp(sweep * sensitivity * 4.0, -1.0, 1.0);\nlet d = x - head;\n// Behind the head is the side it came from: its left while it moves right.\nlet behind = select(0.0, 1.0, d * push < 0.0);\nlet width = 0.12 + 0.8 * behind * abs(push);\nlet band = exp(-(d * d) / (width * width));\nlet shimmer = 0.75 + 0.25 * snoise3(vec3f(c.pos * 2.5, speed));\nlet lit = clamp(abs(push) + activity, 0.0, 1.0);\nlet hue = mix(left_hue, right_hue, x * 0.5 + 0.5);\nlet left_glow = (1.0 - smoothstep(-0.9, 0.1, x)) * left;\nlet right_glow = smoothstep(-0.1, 0.9, x) * right;\nlet trail = hsv2rgb(hue, saturation, 1.0) * band * lit * shimmer;\nlet sides = hsv2rgb(left_hue, saturation, 1.0) * left_glow + hsv2rgb(right_hue, saturation, 1.0) * right_glow;\nout = vec4f((trail + side_fill * sides) * brightness, 1.0);\n"
      }
    },
