{
  "format": 1,
  "id": "builtin-touch-ripples",
  "name": "Touch Ripples",
  "description": "A patch that owns touch: every finger glows in its toucher's color and grows while held, and each touchdown fires a burst where it landed, over a dim plasma. Rewire the Touch node to make touch do anything else.",
  "nodes": [
    { "id": "touch", "kind": "touch", "name": "", "params": { "follow": 0 }, "pos": [40, 300] },
    { "id": "burst", "kind": "event_effect", "name": "tap burst", "params": { "effect": 1, "intensity": 1.2, "size": 1.0 }, "pos": [320, 300] },
    { "id": "bg", "kind": "plasma", "name": "", "params": { "scale": 1.4, "speed": 0.25, "hue": 0.62, "hue_range": 0.25, "brightness": 0.22 }, "pos": [320, 40] },
    { "id": "glow", "kind": "touch_glow", "name": "", "params": { "radius": 0.1, "soft": 0.7, "fade": 0.9, "grow": 0.6, "trail": 0.6, "intensity": 1.2 }, "pos": [320, 600] },
    { "id": "mix", "kind": "blend", "name": "", "params": { "mode": 0 }, "pos": [600, 200] },
    { "id": "out", "kind": "output", "name": "", "params": {}, "pos": [840, 200] }
  ],
  "edges": [
    { "from": { "node": "touch", "port": "down" }, "to": { "node": "burst", "port": "trigger" } },
    { "from": { "node": "touch", "port": "angle" }, "to": { "node": "burst", "port": "angle" } },
    { "from": { "node": "touch", "port": "radius" }, "to": { "node": "burst", "port": "radius" } },
    { "from": { "node": "touch", "port": "hue" }, "to": { "node": "burst", "port": "hue" } },
    { "from": { "node": "bg", "port": "out" }, "to": { "node": "mix", "port": "base" } },
    { "from": { "node": "glow", "port": "out" }, "to": { "node": "mix", "port": "over" } },
    { "from": { "node": "mix", "port": "out" }, "to": { "node": "out", "port": "in" } }
  ],
  "exposed": [
    { "node": "glow", "param": "radius", "label": "Finger size" },
    { "node": "glow", "param": "grow", "label": "Grow while held" },
    { "node": "bg", "param": "brightness", "label": "Background" }
  ]
}
