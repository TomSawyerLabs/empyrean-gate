{
  "name": "@empyrean-gate/patch-web",
  "version": "0.16.0",
  "private": true,
  "license": "MIT",
  "description": "The Empyrean Gate's patch editor and a WebGPU runtime for its patches, for use outside the desktop app",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./editor": "./src/editor/index.ts",
    "./editor.css": "./src/editor/editor.css",
    "./files": "./src/editor/files.ts",
    "./runtime": "./src/runtime/index.ts",
    "./types": "./src/types.ts",
    "./agent": "./src/agent/index.ts"
  },
  "scripts": {
    "build:wasm": "bun scripts/build-wasm.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p cli/tsconfig.json && tsc -p browser/tsconfig.json",
    "test": "bun test src cli",
    "test:browser": "playwright test -c playwright.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "thumbnails": "bun scripts/thumbnails.ts",
    "arrange-presets": "bun scripts/arrange-presets.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^3.1.1",
    "@lezer/highlight": "^1.2.5",
    "@webgpu/types": "^0.1.66"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.11.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webgpu": "^0.6.2"
  },
  "peerDependenciesMeta": {
    "webgpu": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24"
  }
}
