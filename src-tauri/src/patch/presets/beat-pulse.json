{
  "format": 1,
  "id": "builtin-beat-pulse",
  "name": "Beat Pulse",
  "description": "Rings ride the beat over a slow noise bed; bass fades them in.",
  "nodes": [
    { "id": "aud", "kind": "audio", "name": "", "params": {}, "pos": [40, 60] },
    { "id": "noise", "kind": "noise_field", "name": "", "params": { "scale": 1.2, "speed": 0.3, "threshold": 0.45, "hue": 0.62, "hue_range": 0.25, "brightness": 0.5 }, "pos": [260, 40] },
    { "id": "rings", "kind": "beat_rings", "name": "", "params": { "width": 0.12, "hue": 0.95, "hue_range": 0.15, "brightness": 1.2 }, "pos": [260, 240] },
    { "id": "mix", "kind": "blend", "name": "", "params": {}, "pos": [520, 130] },
    { "id": "out", "kind": "output", "name": "", "params": {}, "pos": [760, 130] }
  ],
  "edges": [
    { "from": { "node": "aud", "port": "beat_phase" }, "to": { "node": "rings", "port": "front" } },
    { "from": { "node": "aud", "port": "bass" }, "to": { "node": "mix", "port": "opacity" } },
    { "from": { "node": "noise", "port": "out" }, "to": { "node": "mix", "port": "base" } },
    { "from": { "node": "rings", "port": "out" }, "to": { "node": "mix", "port": "over" } },
    { "from": { "node": "mix", "port": "out" }, "to": { "node": "out", "port": "in" } }
  ],
  "exposed": [
    { "node": "noise", "param": "hue", "label": "Base hue" },
    { "node": "rings", "param": "hue", "label": "Ring hue" },
    { "node": "out", "param": "master", "label": "Master" }
  ]
}
