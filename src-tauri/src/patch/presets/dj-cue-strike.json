{
  "format": 1,
  "id": "builtin-dj-cue-strike",
  "name": "DJ Cue Strike",
  "description": "Hot-cue and seek jumps crack open angular color shards; cue presses flash the active deck side while BPM drives motion and master audio drives brightness.",
  "nodes": [
    { "id": "link", "kind": "dj_link", "name": "deck events", "params": {}, "pos": [40, 60] },
    { "id": "aud", "kind": "audio", "name": "music input", "params": {}, "pos": [40, 330] },
    { "id": "level_gain", "kind": "scalar_math", "name": "fast master brightness", "params": { "op": 2, "b": 0.82 }, "pos": [280, 550] },
    { "id": "level_floor", "kind": "scalar_math", "name": "brightness floor", "params": { "op": 0, "b": 0.18 }, "pos": [500, 550] },
    { "id": "bed_tempo", "kind": "scalar_math", "name": "bed BPM motion", "params": { "op": 2, "b": 0.18 }, "pos": [280, 440] },
    { "id": "shard_tempo", "kind": "scalar_math", "name": "shard BPM motion", "params": { "op": 2, "b": 0.20 }, "pos": [500, 440] },
    { "id": "jump_env", "kind": "envelope", "name": "jump crack", "params": { "attack": 0.0, "decay": 0.62, "peak": 1.0 }, "pos": [280, 40] },
    { "id": "cue_env", "kind": "envelope", "name": "cue flash", "params": { "attack": 0.0, "decay": 0.24, "peak": 0.9 }, "pos": [280, 150] },
    { "id": "flash", "kind": "scalar_math", "name": "combined strike", "params": { "op": 0 }, "pos": [500, 90] },
    { "id": "side_scale", "kind": "scalar_math", "name": "deck quarter-turn", "params": { "op": 2, "b": 0.25 }, "pos": [720, 250] },
    { "id": "bed", "kind": "radial_waves", "name": "rolling deck bed", "params": { "waves": 3, "scale": 1.2, "speed": 0.18, "sharpness": 0.66, "hue": 0.64, "hue_range": 0.12, "saturation": 0.88, "brightness": 0.36 }, "pos": [300, 350] },
    { "id": "shards", "kind": "wedges", "name": "cue shards", "params": { "slices": 8, "softness": 0.10, "twist": 0.58, "flash": 0.0, "speed": 0.20, "hue": 0.02, "hue_range": 0.34, "saturation": 0.88, "brightness": 1.22 }, "pos": [720, 100] },
    { "id": "deck_side", "kind": "transform", "name": "event deck side", "params": { "rotate": 0, "spin": 0.0, "zoom": 1.0 }, "pos": [940, 100] },
    { "id": "mix", "kind": "blend", "name": "strike over bed", "params": { "mode": 0, "opacity": 0.86 }, "pos": [1160, 260] },
    { "id": "out", "kind": "output", "name": "", "params": { "master": 0.92 }, "pos": [1380, 260] }
  ],
  "edges": [
    { "from": { "node": "link", "port": "jump" }, "to": { "node": "jump_env", "port": "trigger" } },
    { "from": { "node": "link", "port": "cue" }, "to": { "node": "cue_env", "port": "trigger" } },
    { "from": { "node": "jump_env", "port": "out" }, "to": { "node": "flash", "port": "a" } },
    { "from": { "node": "cue_env", "port": "out" }, "to": { "node": "flash", "port": "b" } },
    { "from": { "node": "flash", "port": "out" }, "to": { "node": "shards", "port": "flash" } },
    { "from": { "node": "link", "port": "event_side" }, "to": { "node": "side_scale", "port": "a" } },
    { "from": { "node": "aud", "port": "tempo" }, "to": { "node": "bed_tempo", "port": "a" } },
    { "from": { "node": "bed_tempo", "port": "out" }, "to": { "node": "bed", "port": "speed" } },
    { "from": { "node": "aud", "port": "tempo" }, "to": { "node": "shard_tempo", "port": "a" } },
    { "from": { "node": "shard_tempo", "port": "out" }, "to": { "node": "shards", "port": "speed" } },
    { "from": { "node": "aud", "port": "level" }, "to": { "node": "level_gain", "port": "a" } },
    { "from": { "node": "level_gain", "port": "out" }, "to": { "node": "level_floor", "port": "a" } },
    { "from": { "node": "level_floor", "port": "out" }, "to": { "node": "out", "port": "master" } },
    { "from": { "node": "shards", "port": "out" }, "to": { "node": "deck_side", "port": "in" } },
    { "from": { "node": "side_scale", "port": "out" }, "to": { "node": "deck_side", "port": "rotate" } },
    { "from": { "node": "bed", "port": "out" }, "to": { "node": "mix", "port": "base" } },
    { "from": { "node": "deck_side", "port": "out" }, "to": { "node": "mix", "port": "over" } },
    { "from": { "node": "mix", "port": "out" }, "to": { "node": "out", "port": "in" } }
  ],
  "exposed": [
    { "node": "jump_env", "param": "decay", "label": "Jump decay" },
    { "node": "shards", "param": "slices", "label": "Shard count" },
    { "node": "shards", "param": "hue", "label": "Strike hue" },
    { "node": "aud", "param": "source", "label": "Audio source" },
    { "node": "bed_tempo", "param": "b", "label": "BPM motion" },
    { "node": "level_gain", "param": "b", "label": "Music brightness" },
    { "node": "level_floor", "param": "b", "label": "Brightness floor" }
  ]
}
